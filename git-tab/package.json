{
  "name": "@local/dsh-git",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live Git state for the Session's working directory: branch, HEAD, upstream divergence, worktree identity, and the staged/unstaged/untracked split, with one-click repository initialization.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
